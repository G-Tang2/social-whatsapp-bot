# Copy this file to `.env` and fill in your values.
# .env is loaded automatically by index.js (via the `dotenv` package) and is
# git/docker-ignored so your group JID stays local.

# Comma-separated WhatsApp group JID(s) the bot should moderate.
# Leave empty on first run - the bot will log the JID of any group you send
# a "!" command in, so you can copy it here.
ALLOWED_GROUPS=

# Optional: used only for the bot's name in the !help message (e.g.
# "*Signup list bot*"). Doesn't affect the list itself - the list's own
# header (date/location/courts/time) is set per-group via !newlist or
# !location/!courts/!time, no env var involved.
LIST_TITLE=Signup list

# Optional: default header for the payment-due section (the people who
# signed up last time and now owe money). Defaults to "Payment" if unset.
# Only used to seed brand-new groups - once a group has run !newlist or
# !duelabel, its own header is stored per-group and this env var no longer
# affects it. Admins can change a group's header live in chat with
# !duelabel, no restart needed.
PAYMENT_LABEL=Payment

# Optional: default max number of people on the list before !in starts
# waitlisting instead. Only used before any real court count is known -
# once an admin sets !courts (or specifies it via !newlist), the limit
# auto-scales instead: 6 people per court by default (e.g. 6 courts -> 36,
# 4 courts -> 24; edit PLAYERS_PER_COURT in store.js to change that ratio).
# DEFAULT_LIMIT defaults to 6 if unset, and only seeds brand-new groups
# before that happens - once a group has run !limit or !courts, its own
# limit is stored per-group and this env var no longer affects it. Set to
# 0, none, off, or unlimited for no default cap. Admins can change a
# group's limit live in chat with !limit, no restart needed.
DEFAULT_LIMIT=6

# Optional: set to true to log every incoming message (chat, sender, fromMe,
# text) before any filtering, useful for diagnosing "nothing happened" issues.
DEBUG=false

# Inactivity reminders: the bot can tag members who've gone quiet in chat
# with a warning that they may be removed if they stay quiet. This is
# turned on/off per group with the !inactivity on / !inactivity off chat
# command (admins only), NOT with an env var - every group starts off, and
# each one opts in independently, so the bot can watch one group chat for
# quiet members without doing the same in every other group it moderates.
# The three settings below only tune the timing for whichever groups have
# it turned on; they don't turn the feature on themselves. Requires
# ALLOWED_GROUPS to include the group (the bot can only track activity in
# groups it's actually watching). See the README's "Reminding inactive
# members" section for the full behavior, including that this is
# warn-only - the bot never removes anyone itself, an admin does that
# manually from WhatsApp's own group UI once !stale shows someone overdue.

# How many days of silence before someone gets a first warning. Defaults
# to 1 if unset. Fractional values work too if you want less than a full
# day, e.g. 0.5 for 12 hours.
INACTIVITY_WARN_AFTER_DAYS=1

# How many days after that first warning someone is considered overdue for
# (manual) removal - shown via !stale. Defaults to 1 if unset. This is
# informational only; the bot doesn't act on it automatically.
INACTIVITY_REMOVE_AFTER_DAYS=1

# How often (in days) the background inactivity check runs. Defaults to 1
# if unset - once a day is plenty since the thresholds above are measured
# in days, not hours or minutes. Fractional values work too, e.g. 0.25 to
# check every 6 hours instead.
INACTIVITY_CHECK_INTERVAL_DAYS=1

# Spam filtering (auto-deletes stock/crypto spam - a message needs both a
# link and a finance/crypto keyword to count) has no env vars at all - it's
# turned on/off per group entirely with the !spamfilter on / !spamfilter
# off chat command (admins only), same off-by-default-per-group pattern as
# inactivity reminders above. The keyword list lives in spam.js
# (SPAM_KEYWORDS) if you need to edit it. See the README's "Spam filtering"
# section, including the requirement that the bot's own WhatsApp account
# needs to be a group admin for deletions to actually work.

# Natural-language commands: @-mention the bot with a plain-English
# request (e.g. "@bot put me down for Saturday") instead of typing exact
# !in/!out/!paid/!list syntax, and it'll try to work out which one you
# meant using the Gemini API - see the README's "Natural-language
# commands" section for exactly how confidence/confirmation works.
# Like spam filtering, this is turned on/off per group with a chat command
# (!ai on / !ai off, admins only) rather than an env var - but unlike spam
# filtering, it's OFF by default everywhere, since it calls an external
# paid API and can misread ordinary chat, so it's an explicit opt-in
# rather than a safety default every group gets automatically.
#
# GEMINI_API_KEY below is required for !ai on to even be allowed - get a
# free key from https://aistudio.google.com/apikey. Leave it unset if you
# don't want this feature at all; every other command works exactly the
# same either way.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to gemini-2.5-flash if
# unset - a small/fast model is plenty for mapping a short message to one
# of 4 commands, and a faster response matters more here than raw
# reasoning power.
GEMINI_MODEL=

# How many seconds to wait, after the last caught-up !in/!out/!paid command,
# before treating the offline backlog as fully drained and sending the
# combined "here's what happened while I was offline" summary (see the
# README's "Catching up after a network outage" section). Defaults to 5 if
# unset. You shouldn't normally need to change this - it only matters if
# your connection tends to redeliver a large backlog across many separate
# bursts, in which case raising it gives straggling messages more time to
# arrive before the summary is sent.
CATCH_UP_FLUSH_DELAY_SECONDS=5

# "Last seen" WhatsApp About/status heartbeat: the bot keeps its own
# WhatsApp profile About text updated with the current date/time, e.g.
# "Last seen: 14 Aug 2026, 3:45 PM [updates every 5 minutes]" - so you (or
# anyone) can open the bot's WhatsApp contact/profile and tell at a glance
# that it's alive and how current its connection is, no terminal/log access
# needed. The "[updates every N minutes]" part is generated from
# LAST_SEEN_STATUS_INTERVAL_MINUTES below, so it stays accurate if you
# change that value. Refreshed immediately on every connect/reconnect, then
# on the interval below. On by default.

# Set to false to turn this off entirely.
LAST_SEEN_STATUS=true

# How often (in minutes) to refresh it while connected. Defaults to 5 if
# unset.
LAST_SEEN_STATUS_INTERVAL_MINUTES=5

# IANA timezone the displayed time is shown in, e.g. "Australia/Sydney" or
# "America/New_York" (full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones). Defaults to
# the host machine/server's own timezone if unset - fine when running
# locally on your own computer, but almost certainly wrong on a cloud server
# (e.g. Fly.io defaults to UTC) unless your group is actually in UTC. Set
# this explicitly in that case.
TIMEZONE=
